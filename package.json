{
  "name": "mlnomadpy-personal-site",
  "version": "1.0.0",
  "private": true,
  "description": "Taha Bouhsine’s personal space for research, poems, talks, and music",
  "author": "Taha Bouhsine",
  "license": "MIT",
  "homepage": "https://www.tahabouhsine.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlnomadpy/mlnomadpy.github.io"
  },
  "keywords": [
    "machine learning",
    "artificial intelligence",
    "research",
    "vue",
    "portfolio",
    "google developer expert",
    "neural networks",
    "MLNomads"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:portfolio && npm run build:writing && node scripts/assemble-site.mjs",
    "serve": "vite preview",
    "check": "node scripts/check-build.mjs && npm run check:schema && npm run check:seo && npm run check:blog",
    "check:seo": "node --test scripts/search-meta.test.mjs && node scripts/check-seo.mjs",
    "check:schema": "node --test scripts/schema.test.mjs && node scripts/check-schema.mjs",
    "dev:portfolio": "vite",
    "build:portfolio": "vite-ssg build",
    "build:writing": "npm run build --workspace writing",
    "check:blog": "node --test scripts/blog-publication.test.mjs && node scripts/check-blog.mjs"
  },
  "dependencies": {
    "@unhead/vue": "^2.1.2",
    "vue": "^3.2.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "parse5": "^7.3.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "vite": "^8.3.5",
    "vite-ssg": "^28.3.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "type": "module",
  "workspaces": [
    "writing"
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "katex": "0.19.1"
  }
}
