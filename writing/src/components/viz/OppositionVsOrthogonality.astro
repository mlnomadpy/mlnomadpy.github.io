---
interface Props { caption?: string; height?: number; }
const { caption, height = 340 } = Astro.props;
---
<figure class="viz oppositionorthogonality" data-caption={caption} data-height={height} data-height-mobile="480" tabindex="0">
  <div class="viz-cell"></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<script>
import { defineViz } from './engine/vizkit.js';
import { arrow, T } from './engine/draw.js';
import { drag } from './engine/pointer.js';

// Pointer and keyboard controls share the same tenth-degree resolution.
function angleValue(value) {
  return Math.round(Math.max(0, Math.min(360, Number(value) || 0)) * 10) / 10;
}
function angleMetrics(degrees) {
  const radians = degrees * Math.PI / 180;
  const cosine = Math.cos(radians), square = cosine * cosine;
  const dependent = degrees % 180 === 0;
  return { cosine, square, residual: 1 - square, dimension: dependent ? 1 : 2,
    status: dependent ? (cosine > 0 ? 'parallel' : 'antiparallel')
      : degrees % 180 === 90 ? 'orthogonal; linearly independent' : 'linearly independent' };
}
function setAngle(api, value) {
  const angle = angleValue(value);
  api.setControl('angle', angle); api.setControl('degrees', angle);
}
defineViz('oppositionorthogonality', {
  title: 'Opposition and orthogonality answer different questions',
  height: 340,
  controls: [
    { type: 'range', name: 'angle', label: 'angle θ', min: 0, max: 360, step: 0.1, value: 60, reset: false, fmt: v => v.toFixed(1) + '°' },
    { type: 'number', name: 'degrees', label: 'angle in degrees', min: 0, max: 360, step: 0.1, value: 60, width: 78, reset: false },
    { type: 'newrow' },
    { type: 'button', name: 'parallel', label: 'Parallel: 0°' },
    { type: 'button', name: 'orthogonal', label: 'Orthogonal: 90°' },
    { type: 'button', name: 'antiparallel', label: 'Antiparallel: 180°' },
    { type: 'readout', name: 'metrics' },
  ],
  onControl(name, value, api) { if (name === 'angle' || name === 'degrees') setAngle(api, value); },
  onAction(name, api) {
    const presets = { parallel: 0, orthogonal: 90, antiparallel: 180 };
    if (name in presets) setAngle(api, presets[name]);
  },
  setup(api) {
    const update = p => {
      const g = api.state.geometry; if (!g) return;
      let degrees = Math.atan2(-(p.y - g.cy), p.x - g.cx) * 180 / Math.PI;
      if (degrees < 0) degrees += 360;
      setAngle(api, degrees); api.render();
    };
    const cleanup = drag(api.canvas, { cursor: 'grab', onStart: update, onMove: update });
    if (typeof cleanup === 'function') api.onCleanup?.(cleanup);
  },
  draw(api) {
    const { ctx, colors, size } = api, W = size.W, H = size.H; if (!W) return;
    const degrees = angleValue(api.get('angle')), theta = degrees * Math.PI / 180, metrics = angleMetrics(degrees);
    const stacked = W < 580, plotW = stacked ? W : W * 0.62, plotH = stacked ? H - 155 : H;
    const cx = plotW / 2, cy = plotH / 2, R = Math.max(30, Math.min(plotW - 62, plotH - 56) / 2);
    api.state.geometry = { cx, cy, R };
    ctx.clearRect(0, 0, W, H);
    ctx.save();
    ctx.strokeStyle = colors.border; ctx.lineWidth = 1; ctx.beginPath(); ctx.arc(cx, cy, R, 0, 2 * Math.PI); ctx.stroke();
    ctx.setLineDash([2, 4]); ctx.beginPath(); ctx.moveTo(cx - R - 15, cy); ctx.lineTo(cx + R + 15, cy); ctx.moveTo(cx, cy - R - 15); ctx.lineTo(cx, cy + R + 15); ctx.stroke(); ctx.setLineDash([]);
    ctx.globalAlpha = 0.08;
    if (metrics.dimension === 1) { ctx.strokeStyle = colors.accent; ctx.lineWidth = 9; ctx.beginPath(); ctx.moveTo(cx - R - 12, cy); ctx.lineTo(cx + R + 12, cy); ctx.stroke(); }
    else { ctx.fillStyle = colors.accent; ctx.fillRect(cx - R - 12, cy - R - 12, 2 * R + 24, 2 * R + 24); }
    ctx.globalAlpha = 1;
    const vx = cx + R * metrics.cosine, vy = cy - R * Math.sin(theta);
    ctx.strokeStyle = colors.muted; ctx.setLineDash([3, 4]); ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(vx, cy); ctx.lineTo(vx, vy); ctx.stroke(); ctx.setLineDash([]);
    if (Math.abs(vx - cx) > 4) arrow(ctx, cx, cy, vx, cy, colors.muted, 1);
    ctx.strokeStyle = colors.accent; ctx.beginPath(); ctx.arc(cx, cy, R * .22, -theta, 0); ctx.stroke();
    arrow(ctx, cx, cy, cx + R, cy, colors.accent, 2.2);
    arrow(ctx, cx, cy, vx, vy, colors.blue, 2.2);
    T(ctx, colors, 'label', { color: colors.accent }); ctx.fillText('u', cx + R + 8, cy - 7);
    T(ctx, colors, 'label', { color: colors.blue }); ctx.fillText('v', Math.max(8, Math.min(plotW - 16, vx + 10)), Math.max(14, vy - 10));
    ctx.fillStyle = colors.blue; ctx.beginPath(); ctx.arc(vx, vy, 6, 0, 2 * Math.PI); ctx.fill(); ctx.strokeStyle = colors.bg; ctx.lineWidth = 2; ctx.stroke();
    T(ctx, colors, 'small', { align: 'center', color: colors.muted }); ctx.fillText('drag the blue tip, or use the angle controls', cx, plotH - 8);
    ctx.restore();
    const x = stacked ? 16 : plotW + 8, y = stacked ? plotH + 15 : Math.max(30, H / 2 - 72);
    const f = v => Math.abs(v) < 1e-12 ? '0.000' : v.toFixed(3);
    const rows = [['θ', degrees.toFixed(1) + '°'], ['cos θ', f(metrics.cosine)], ['cos²θ', f(metrics.square)], ['1 − cos²θ', f(metrics.residual)], ['dim span(u, v)', String(metrics.dimension)]];
    rows.forEach(([label, value], i) => { T(ctx, colors, 'label', { color: colors.muted }); ctx.fillText(label, x, y + 23 * i); T(ctx, colors, 'label', { align: 'right' }); ctx.fillText(value, W - 18, y + 23 * i); });
    api.readout('metrics', `θ ${degrees.toFixed(1)}° · cos θ ${f(metrics.cosine)} · cos²θ ${f(metrics.square)} · 1 − cos²θ ${f(metrics.residual)} · span dimension ${metrics.dimension} · ${metrics.status}`);
  },
});
</script>
