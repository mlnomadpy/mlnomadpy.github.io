      "note": "Normalization removes radial signal initially. Because labels directly move each point, this sandbox can still fit the labels; it does not test an encoder’s ability to recover that lost signal."
    },
    {
      "id": "low-tau",
      "name": "low temperature",
      "dataset": "moons",
      "param": 0.05,
      "note": "Low temperature concentrates row probabilities on high similarities. Stability also depends on step size and the sampled positives."
    },
    {
      "id": "high-tau",
      "name": "high temperature",
      "dataset": "moons",
      "param": 1.2,
      "note": "Higher temperature flattens row probabilities and scales their derivatives by 1/τ."
    }
  ],
  "clip": [
    {
      "id": "default",
      "name": "random labels",
      "dataset": "random",
      "param": 0.2,
      "note": "Positions are free parameters; class labels define the pair mask. This fits the displayed points, not an encoder."
    },
    {
      "id": "moons",
      "name": "two-moons",
      "dataset": "moons",
      "param": 0.2,
