---
interface Props {
  loss: 'hadsell' | 'triplet' | 'infonce' | 'clip' | 'supcon' | 'siglip' | 'alignunif' | 'orthog';
  preset?: string;
  dataset?: string;
  caption?: string;
  height?: number;
}
const { loss, preset = 'default', caption, height = 360 } = Astro.props;
---
<figure data-min-width="720" class="viz lossexplorer" data-loss={loss} data-preset={preset} data-caption={caption} data-height={height} tabindex="0">
  <div class="viz-cell"></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
import { projectSphere, stepObjective } from './engine/contrastive-objectives.js';
import { defineViz } from './engine/vizkit.js';
import { rng32 } from './engine/datasets.js';
import { dot, cross } from './engine/draw.js';

// One contrastive loss, optimised in-place on a 2-D dataset, with a live param
// slider, preset failure-modes, and loss/accuracy curves. The losses, configs,
// presets and metrics below are the substance; vizkit handles the controls,
// loop, speed, theme, resize, visibility and keyboard. The `loss` prop selects
// which config this instance shows, read per-instance via the spec factory.

const classPalette = ['#b3661b', '#4a7fb3', '#3a8f5e', '#9a4f9c', '#c14b4b', '#5f8da8', '#c08b3c', '#7160a8'];
const classColor = (y, alpha = 1) => { const hex = classPalette[y % classPalette.length]; const r = parseInt(hex.slice(1, 3), 16), g = parseInt(hex.slice(3, 5), 16), b = parseInt(hex.slice(5, 7), 16); return `rgba(${r}, ${g}, ${b}, ${alpha})`; };
const randn = (rng) => { let u = 0, v = 0; while (u === 0) u = rng(); while (v === 0) v = rng(); return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v); };

// ─── datasets ──────────────────────────────────────────────────────────
const makeData = (kind, n, seed) => {
  const rng = rng32(seed); const pts = [], labels = [];
  if (kind === 'moons') {
    const half = Math.floor(n / 2);
    for (let i = 0; i < half; i++) { const t = Math.PI * (i / Math.max(1, half - 1)); pts.push([Math.cos(t) + randn(rng) * 0.07, Math.sin(t) + randn(rng) * 0.07]); labels.push(0); }
    for (let i = 0; i < n - half; i++) { const t = Math.PI * (i / Math.max(1, n - half - 1)); pts.push([1 - Math.cos(t) + randn(rng) * 0.07, 0.4 - Math.sin(t) + randn(rng) * 0.07]); labels.push(1); }
  } else if (kind === 'blobs') {
    const half = Math.floor(n / 2);
    for (let i = 0; i < half; i++) { pts.push([0.35 + randn(rng) * 0.45, 0.0 + randn(rng) * 0.45]); labels.push(0); }
    for (let i = 0; i < n - half; i++) { pts.push([-0.35 + randn(rng) * 0.45, 0.0 + randn(rng) * 0.45]); labels.push(1); }
  } else if (kind === 'rings') {
    const half = Math.floor(n / 2);
    for (let i = 0; i < half; i++) { const t = 2 * Math.PI * rng(); pts.push([0.4 * Math.cos(t) + randn(rng) * 0.05, 0.4 * Math.sin(t) + randn(rng) * 0.05]); labels.push(0); }
    for (let i = 0; i < n - half; i++) { const t = 2 * Math.PI * rng(); pts.push([1.1 * Math.cos(t) + randn(rng) * 0.05, 1.1 * Math.sin(t) + randn(rng) * 0.05]); labels.push(1); }
  } else if (kind === 'four') {
    const per = Math.floor(n / 4); const centers = [[0.6, 0.6], [-0.6, 0.6], [-0.6, -0.6], [0.6, -0.6]];
    for (let c = 0; c < 4; c++) { const k = (c === 3) ? (n - 3 * per) : per; for (let i = 0; i < k; i++) { pts.push([centers[c][0] + randn(rng) * 0.18, centers[c][1] + randn(rng) * 0.18]); labels.push(c); } }
  } else if (kind === 'eight') {
    const per = Math.floor(n / 8);
    for (let c = 0; c < 8; c++) { const k = (c === 7) ? (n - 7 * per) : per; const a = (c / 8) * 2 * Math.PI; const cx = 0.9 * Math.cos(a), cy = 0.9 * Math.sin(a); for (let i = 0; i < k; i++) { pts.push([cx + randn(rng) * 0.12, cy + randn(rng) * 0.12]); labels.push(c); } }
  } else if (kind === 'spiral') {
    const half = Math.floor(n / 2);
    for (let i = 0; i < half; i++) { const t = 0.2 + 2.5 * (i / Math.max(1, half - 1)); const r = 0.15 * t; pts.push([r * Math.cos(t * 2) + randn(rng) * 0.04, r * Math.sin(t * 2) + randn(rng) * 0.04]); labels.push(0); }
    for (let i = 0; i < n - half; i++) { const t = 0.2 + 2.5 * (i / Math.max(1, n - half - 1)); const r = 0.15 * t; pts.push([-r * Math.cos(t * 2) + randn(rng) * 0.04, -r * Math.sin(t * 2) + randn(rng) * 0.04]); labels.push(1); }
  } else if (kind === 'imbalanced') {
    const minority = Math.floor(n * 0.2);
    for (let i = 0; i < n - minority; i++) { const t = Math.PI * (i / Math.max(1, n - minority - 1)); pts.push([Math.cos(t) + randn(rng) * 0.07, Math.sin(t) + randn(rng) * 0.07]); labels.push(0); }
    for (let i = 0; i < minority; i++) { const t = Math.PI * (i / Math.max(1, minority - 1)); pts.push([1 - Math.cos(t) + randn(rng) * 0.07, 0.4 - Math.sin(t) + randn(rng) * 0.07]); labels.push(1); }
  } else if (kind === 'noisy') {
    const half = Math.floor(n / 2);
    for (let i = 0; i < half; i++) { const t = Math.PI * (i / Math.max(1, half - 1)); pts.push([Math.cos(t) + randn(rng) * 0.07, Math.sin(t) + randn(rng) * 0.07]); labels.push(rng() < 0.1 ? 1 : 0); }
    for (let i = 0; i < n - half; i++) { const t = Math.PI * (i / Math.max(1, n - half - 1)); pts.push([1 - Math.cos(t) + randn(rng) * 0.07, 0.4 - Math.sin(t) + randn(rng) * 0.07]); labels.push(rng() < 0.1 ? 0 : 1); }
  } else { // random / random-4
    const k = (kind === 'random-4') ? 4 : 2;
    for (let i = 0; i < n; i++) { pts.push([(rng() * 2 - 1) * 1.5, (rng() * 2 - 1) * 1.5]); labels.push(i % k); }
    for (let i = n - 1; i > 0; i--) { const j = Math.floor(rng() * (i + 1)); [labels[i], labels[j]] = [labels[j], labels[i]]; }
  }
  return { pts, labels };
};
const DATA_OPTS = [
  { value: 'moons', label: 'two-moons' }, { value: 'blobs', label: 'overlapping blobs' }, { value: 'rings', label: 'concentric rings' },
  { value: 'four', label: 'four classes' }, { value: 'eight', label: 'eight classes' }, { value: 'spiral', label: 'two spirals' },
  { value: 'imbalanced', label: 'imbalanced moons (80/20)' }, { value: 'noisy', label: 'noisy moons (10% flip)' },
  { value: 'random', label: 'random (2 classes, no spatial signal)' }, { value: 'random-4', label: 'random (4 classes, no spatial signal)' },
];

// ─── helpers + losses (mutate pts in place, return loss) ─────────────────
const stepHadsell = (pts, labels, lr, rng, params = {}) => stepObjective('hadsell', pts, labels, lr, rng, params);
const stepTriplet = (pts, labels, lr, rng, params = {}) => stepObjective('triplet', pts, labels, lr, rng, params);
const stepInfoNCE = (pts, labels, lr, rng, params = {}) => stepObjective('infonce', pts, labels, lr, rng, params);
const stepCLIP = (pts, labels, lr, rng, params = {}) => stepObjective('clip', pts, labels, lr, rng, params);
const stepSupCon = (pts, labels, lr, rng, params = {}) => stepObjective('supcon', pts, labels, lr, rng, params);
const stepSigLIP = (pts, labels, lr, rng, params = {}) => stepObjective('siglip', pts, labels, lr, rng, params);
const stepAlignUnif = (pts, labels, lr, rng, params = {}) => stepObjective('alignunif', pts, labels, lr, rng, params);
const stepOrthog = (pts, labels, lr, rng, params = {}) => stepObjective('orthog', pts, labels, lr, rng, params);

const CONFIG = {
  hadsell:   { name: 'Pair contrastive (Hadsell)', param: 'margin', paramName: 'margin m', step: stepHadsell, paramRange: [0.1, 4.0], paramDefault: 1.2, paramStep: 0.05, onSphere: false, lr: 0.4 },
  triplet:   { name: 'Triplet', param: 'margin', paramName: 'margin m', step: stepTriplet, paramRange: [0.02, 1.5], paramDefault: 0.3, paramStep: 0.02, onSphere: false, lr: 0.4 },
  infonce:   { name: 'InfoNCE (NT-Xent)', param: 'tau', paramName: 'temperature τ', step: stepInfoNCE, paramRange: [0.05, 1.5], paramDefault: 0.2, paramStep: 0.01, onSphere: true, lr: 0.05 },
  clip:      { name: 'Symmetric NCE (CLIP-inspired)', param: 'tau', paramName: 'temperature τ', step: stepCLIP, paramRange: [0.05, 1.5], paramDefault: 0.2, paramStep: 0.01, onSphere: true, lr: 0.05 },
  siglip:    { name: 'SigLIP (pairwise sigmoid)', param: 'target', paramName: 'logistic transition cosine', step: stepSigLIP, paramRange: [-1.0, 0.0], paramDefault: -0.3, paramStep: 0.02, onSphere: true, lr: 0.01 },
  supcon:    { name: 'Supervised Contrastive (SupCon)', param: 'tau', paramName: 'temperature τ', step: stepSupCon, paramRange: [0.05, 1.5], paramDefault: 0.2, paramStep: 0.01, onSphere: true, lr: 0.05 },
  alignunif: { name: 'Alignment + Uniformity', param: 'lambda', paramName: 'λ (uniformity weight)', step: stepAlignUnif, paramRange: [0.0, 10.0], paramDefault: 1.0, paramStep: 0.1, onSphere: true, lr: 0.04 },
  orthog:    { name: 'Cosine→0 (orthogonality)', param: 'unused', paramName: '', step: stepOrthog, paramRange: [0, 1], paramDefault: 0, paramStep: 1, onSphere: true, lr: 0.08 },
};

const PRESETS = {
  "hadsell": [
    {
      "id": "default",
      "name": "random labels",
      "dataset": "random",
      "param": 1.2,
      "note": "Positions are free parameters; class labels define the pair mask. This fits the displayed points, not an encoder."
    },
    {
      "id": "moons",
      "name": "two-moons",
      "dataset": "moons",
      "param": 1.2,
      "note": "The initial geometry is two noisy moons. Labels still supervise every update."
    },
    {
      "id": "rings",
      "name": "concentric rings",
      "dataset": "rings",
      "param": 1.2,
      "note": "Normalization removes radial signal initially. Because labels directly move each point, this sandbox can still fit the labels; it does not test an encoder’s ability to recover that lost signal."
    },
    {
      "id": "small-margin",
      "name": "small margin",
      "dataset": "blobs",
      "param": 0.2,
      "note": "A smaller margin switches negative terms off at a smaller distance. Positive terms can keep changing the positions."
    },
    {
      "id": "large-margin",
      "name": "large margin",
      "dataset": "blobs",
      "param": 3.5,
      "note": "A larger finite margin asks for a larger separation. Free Euclidean class centers can meet any finite margin; perpetual divergence is not implied."
    }
  ],
  "triplet": [
    {
