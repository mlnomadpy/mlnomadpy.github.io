};

const accuracy = (pts, labels) => {
  const sum = {}, cnt = {};
  for (let i = 0; i < pts.length; i++) { const y = labels[i]; if (!(y in sum)) { sum[y] = [0, 0]; cnt[y] = 0; } sum[y][0] += pts[i][0]; sum[y][1] += pts[i][1]; cnt[y]++; }
  const cents = {}; for (const y in sum) cents[y] = [sum[y][0] / cnt[y], sum[y][1] / cnt[y]];
  let correct = 0;
  for (let i = 0; i < pts.length; i++) { let best = null, bd = Infinity; for (const y in cents) { const d = (pts[i][0] - cents[y][0]) ** 2 + (pts[i][1] - cents[y][1]) ** 2; if (d < bd) { bd = d; best = +y; } } if (best === labels[i]) correct++; }
  return correct / pts.length;
};

// ─── drawing into one canvas: scatter on the left, curves on the right ───
const drawScatter = (ctx, colors, box, cfg, st, api) => {
  const { x: bx, y: by, w: W, h: H } = box;
  ctx.fillStyle = colors.cellBg; ctx.fillRect(bx, by, W, H); ctx.strokeStyle = colors.border; ctx.lineWidth = 1; ctx.strokeRect(bx + 0.5, by + 0.5, W - 1, H - 1);
  const pad = 12; const cx = bx + pad + (W - 2 * pad) / 2, cy = by + pad + (H - 2 * pad) / 2;
  const range = cfg.onSphere ? 1.25 : 2.6; const s = Math.min(W, H) / (range * 2) - pad / range;
  if (cfg.onSphere) { ctx.strokeStyle = colors.border; ctx.setLineDash([2, 3]); ctx.beginPath(); ctx.arc(cx, cy, s, 0, Math.PI * 2); ctx.stroke(); ctx.setLineDash([]); }
  ctx.strokeStyle = colors.border; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(bx + pad, cy); ctx.lineTo(bx + W - pad, cy); ctx.moveTo(cx, by + pad); ctx.lineTo(cx, by + H - pad); ctx.stroke();
  const sum = {}, cnt = {};
  for (let i = 0; i < st.pts.length; i++) { const y = st.labels[i]; if (!(y in sum)) { sum[y] = [0, 0]; cnt[y] = 0; } sum[y][0] += st.pts[i][0]; sum[y][1] += st.pts[i][1]; cnt[y]++; }
  for (const y in sum) { const mx = sum[y][0] / cnt[y], my = sum[y][1] / cnt[y]; cross(ctx, cx + mx * s, cy - my * s, 6, classColor(+y, 1)); }
  for (let i = 0; i < st.pts.length; i++) dot(ctx, cx + st.pts[i][0] * s, cy - st.pts[i][1] * s, 3.2, classColor(st.labels[i], 0.85));
  ctx.fillStyle = colors.fg; ctx.font = '600 12px ui-sans-serif, system-ui'; ctx.textAlign = 'left'; ctx.textBaseline = 'top'; ctx.fillText(cfg.name, bx + 10, by + 8);
  ctx.fillStyle = colors.faint; ctx.font = '10px ui-monospace, monospace'; ctx.fillText(cfg.onSphere ? 'embeddings constrained to unit circle' : 'Euclidean embeddings', bx + 10, by + 24);
  if (api.iter === 0 && !api.playing) {
    const hint = '▶ press Play to optimize'; ctx.font = '600 13px ui-sans-serif, system-ui'; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
    const tm = ctx.measureText(hint); const bw = tm.width + 20, bh = 26; const hbx = cx - bw / 2, hby = by + H - pad - bh - 4;
    ctx.fillStyle = colors.accent; ctx.globalAlpha = 0.92; ctx.beginPath(); if (ctx.roundRect) ctx.roundRect(hbx, hby, bw, bh, 6); else ctx.rect(hbx, hby, bw, bh); ctx.fill(); ctx.globalAlpha = 1;
    ctx.fillStyle = colors.bg; ctx.fillText(hint, cx, hby + bh / 2);
  }
};

const drawPlots = (ctx, colors, box, st) => {
  const { x: bx, y: by, w: W, h: H } = box;
  ctx.fillStyle = colors.cellBg; ctx.fillRect(bx, by, W, H); ctx.strokeStyle = colors.border; ctx.lineWidth = 1; ctx.strokeRect(bx + 0.5, by + 0.5, W - 1, H - 1);
  const padL = 36, padR = 14, padT = 18, padB = 18; const halfH = (H - 2 * padT - padB - 8) / 2;
  const top = { x: bx + padL, y: by + padT, w: W - padL - padR, h: halfH };
  const bot = { x: bx + padL, y: by + padT + halfH + 16, w: W - padL - padR, h: halfH };
  const drawPanel = (R, data, label, ymin, ymax, color, axisFmt) => {
    ctx.strokeStyle = colors.border; ctx.lineWidth = 1; ctx.strokeRect(R.x + 0.5, R.y + 0.5, R.w - 1, R.h - 1);
    ctx.fillStyle = colors.fg; ctx.font = '600 11px ui-sans-serif, system-ui'; ctx.textAlign = 'left'; ctx.textBaseline = 'bottom'; ctx.fillText(label, R.x, R.y - 4);
    ctx.fillStyle = colors.faint; ctx.font = '10px ui-monospace, monospace'; ctx.textAlign = 'right'; ctx.textBaseline = 'middle';
    const yTicks = 4; ctx.strokeStyle = colors.border; ctx.setLineDash([2, 3]);
    for (let k = 0; k <= yTicks; k++) { const yv = ymin + (k / yTicks) * (ymax - ymin); const yy = R.y + R.h - (k / yTicks) * R.h; ctx.beginPath(); ctx.moveTo(R.x, yy); ctx.lineTo(R.x + R.w, yy); ctx.stroke(); ctx.fillText(axisFmt(yv), R.x - 4, yy); }
    ctx.setLineDash([]);
    if (data.length > 1) {
      const xMax = Math.max(60, data.length); ctx.strokeStyle = color; ctx.lineWidth = 1.5; ctx.beginPath();
      for (let k = 0; k < data.length; k++) { const xx = R.x + (k / (xMax - 1)) * R.w; const t = (data[k] - ymin) / (ymax - ymin); const yy = R.y + R.h - t * R.h; if (k === 0) ctx.moveTo(xx, yy); else ctx.lineTo(xx, yy); }
      ctx.stroke();
    }
  };
  const recent = st.lossHistory.slice(-200); let lmin = 0, lmax = 1;
  if (recent.length) { lmin = Math.min(0, ...recent); lmax = Math.max(...recent, 0.001); if (lmax - lmin < 1e-6) lmax = lmin + 1; }
  drawPanel(top, st.lossHistory, 'loss', lmin, lmax, colors.accent, (v) => v.toFixed(2));
  drawPanel(bot, st.accHistory, 'in-sample centroid fit', 0, 1, colors.green, (v) => (v * 100).toFixed(0) + '%');
};

defineViz('lossexplorer', (root) => {
  const loss = root.dataset.loss; const presetId = root.dataset.preset || 'default';
  const cfg = CONFIG[loss], presets = PRESETS[loss];
  const pre = presets.find((p) => p.id === presetId) || presets[0];
  const hasParam = cfg.param !== 'unused';
  const controls = [
    { type: 'select', name: 'preset', label: 'preset', value: pre.id, options: presets.map((p) => ({ value: p.id, label: p.name })) },
    { type: 'select', name: 'data', label: 'data', value: pre.dataset, options: DATA_OPTS },
    ...(hasParam ? [{ type: 'range', name: 'param', label: cfg.paramName, min: cfg.paramRange[0], max: cfg.paramRange[1], step: cfg.paramStep, value: pre.param, reset: false, fmt: (v) => (+v).toFixed(2) }] : []),
    { type: 'newrow' }, { type: 'play' }, { type: 'step' }, { type: 'reset' }, { type: 'speed' }, { type: 'readout', name: 'ro' },
  ];
  return {
    title: cfg.name,
    height: 360, autoplay: false, annotation: true, stepsPerFrame: 1, controls,
    onControl(name, value, api) {
      if (name !== 'preset') return;
      const p = presets.find((x) => x.id === value) || presets[0];
      api.setControl('data', p.dataset); if (hasParam) api.setControl('param', p.param); api.note(p.note);
    },
    setup(api) {
      const ds = api.get('data'); const n = (ds === 'eight') ? 80 : 60; const seed = 7;
      const { pts, labels } = makeData(ds, n, seed); if (cfg.onSphere) projectSphere(pts);
      const st = api.state; st.pts = pts; st.labels = labels; st.rng = rng32(seed * 17 + loss.charCodeAt(0));
      st.lossHistory = []; st.accHistory = []; st.lastLoss = NaN; st.lastAcc = accuracy(pts, labels); st.accHistory.push(st.lastAcc);
      const p = presets.find((x) => x.id === api.get('preset')) || presets[0]; api.note(p.note);
    },
    step(api) {
      const g = hasParam ? api.get('param') : cfg.paramDefault; const param = { margin: g, tau: g, lambda: g, target: g }; const st = api.state;
      st.lastLoss = cfg.step(st.pts, st.labels, cfg.lr, st.rng, param); st.lastAcc = accuracy(st.pts, st.labels);
      st.lossHistory.push(st.lastLoss); st.accHistory.push(st.lastAcc);
      if (st.lossHistory.length > 400) st.lossHistory.shift(); if (st.accHistory.length > 400) st.accHistory.shift();
    },
    draw(api) {
      const { ctx, colors, size, state: st } = api; const W = size.W, H = size.H; if (W === 0 || !st.pts) return;
      const scW = Math.round(W * 0.54);
      drawScatter(ctx, colors, { x: 0, y: 0, w: scW, h: H }, cfg, st, api);
      drawPlots(ctx, colors, { x: scW + 6, y: 0, w: W - scW - 6, h: H }, st);
      api.readout('ro', `iter ${api.iter} · in-sample fit ${(st.lastAcc * 100).toFixed(0)}%` + (isFinite(st.lastLoss) ? ` · L ${st.lastLoss.toFixed(3)}` : ''));
    },
  };
});
</script>
