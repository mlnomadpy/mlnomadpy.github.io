    },
    {
      "id": "imbalanced",
      "name": "80/20 labels",
      "dataset": "imbalanced",
      "param": 0.2,
      "note": "Anchors are averaged equally. More majority anchors and candidates change the objective’s weighting; averaging over positives does not by itself amplify a row."
    },
    {
      "id": "noisy",
