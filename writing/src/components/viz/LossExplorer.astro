    },
    {
      "id": "moons",
      "name": "two-moons",
      "dataset": "moons",
      "param": 0,
      "note": "The initial geometry is two noisy moons. Labels still supervise every update."
    },
    {
      "id": "rings",
      "name": "concentric rings",
      "dataset": "rings",
      "param": 0,
      "note": "Normalization removes radial signal initially. Because labels directly move each point, this sandbox can still fit the labels; it does not test an encoder’s ability to recover that lost signal."
    },
    {
      "id": "four",
      "name": "four classes",
      "dataset": "random-4",
      "param": 0,
      "note": "Four nonzero class directions cannot all be orthogonal in two dimensions. Nonzero minimum loss does not imply impossible classification."
    },
    {
      "id": "eight",
      "name": "eight classes",
      "dataset": "eight",
      "param": 0,
      "note": "Eight class directions also frustrate the orthogonality target. Multiple compromises may exist; evenly spaced angles are not guaranteed."
    }
