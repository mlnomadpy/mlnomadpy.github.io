---
import { writingSections } from "../../lib/sections.mjs";
const { section, breadcrumbs } = Astro.props;
const info = writingSections[section];
---

<div class="writing-bar wrap">
  <nav class="writing-breadcrumbs" aria-label="Breadcrumb">
    <ol role="list">
      {breadcrumbs.map((crumb, index) => (
        <li>
          {index === breadcrumbs.length - 1 ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={new URL(crumb.item).pathname}>{crumb.name}</a>
          )}
        </li>
      ))}
    </ol>
  </nav>
  <a
    class="writing-rss"
    href={info.path + "rss.xml"}
    aria-label={`Follow ${info.title.toLowerCase()} by RSS`}
  >
    <svg
      viewBox="0 0 20 20"
      width="15"
      height="15"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="4.5" cy="15.5" r="1" fill="currentColor" />
      <path
        d="M4 9a7 7 0 0 1 7 7M4 4a12 12 0 0 1 12 12"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
      />
    </svg>
    RSS
  </a>
</div>
