---
import { publishedPosts } from "../../lib/posts";
import SiteLayout from "../layouts/SiteLayout.astro";
import { writingGraph } from "../../lib/schema.mjs";
import { writingSections } from "../../lib/sections.mjs";
import { newestFirst } from "../../lib/presentation.mjs";
import WritingEntry from "./WritingEntry.astro";
const { section } = Astro.props;
const info = writingSections[section];
const posts = newestFirst(await publishedPosts(section));
const years = [...new Set(posts.map((post) => post.data.pubDate.slice(0, 4)))];
---

<SiteLayout
  title={info.title}
  description={info.description}
  graph={writingGraph(posts, undefined, section)}
  section={section}
>
  <div class="wrap writing-page">
    <header class="writing-heading">
      <h1>{info.title}</h1>
      <p>{info.intro}</p>
    </header>
    {posts.length ? (
      <>
        <div class="archive-tools">
          <nav class="archive-years" aria-label="Jump to year">
            {years.map((year) => (
              <a href={`#year-${year}`}>{year}</a>
            ))}
          </nav>
          <label class="archive-notes-control">
            <input
              type="checkbox"
              id="archive-notes"
              aria-controls="writing-archive"
            />
            Show notes
          </label>
        </div>
        <div class="writing-archive" id="writing-archive">
          {years.map((year) => (
            <section class="writing-year" aria-labelledby={`year-${year}`}>
              <header class="writing-year-heading">
                <h2 id={`year-${year}`}>{year}</h2>
                <span>
                  {
                    posts.filter((post) => post.data.pubDate.startsWith(year))
                      .length
                  }{" "}
                  {section === "writeups" ? "writeups" : "posts"}
                </span>
              </header>
              <ol class="writing-register" role="list">
                {posts
                  .filter((post) => post.data.pubDate.startsWith(year))
                  .map((post) => (
                    <WritingEntry post={post} />
                  ))}
              </ol>
            </section>
          ))}
        </div>
      </>
    ) : (
      <section class="quiet-notebook" aria-labelledby="notebook-title">
        <div>
          <h2 id="notebook-title">{info.emptyTitle}</h2>
          <p>{info.emptyText}</p>
          <p class="notebook-elsewhere">
            {section === "blog" ? (
              <a href={writingSections.writeups.path}>Read the writeups</a>
            ) : (
              <a href="/poetry">Read the poems</a>
            )}
          </p>
        </div>
      </section>
    )}
  </div>
</SiteLayout>
