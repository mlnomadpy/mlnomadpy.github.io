---
import { render } from "astro:content";
import { publishedPosts } from "../../lib/posts";
import SiteLayout from "../layouts/SiteLayout.astro";
import { writingGraph } from "../../lib/schema.mjs";
import { postSection, writingSections } from "../../lib/sections.mjs";
import { newestFirst } from "../../lib/presentation.mjs";
import ArticleDetails from "../components/ArticleDetails.astro";
import ArticleNavigation from "../components/ArticleNavigation.astro";
import PostLink from "../components/PostLink.astro";
export async function getStaticPaths() {
  const posts = newestFirst(await publishedPosts());
  return posts.map((post) => {
    const siblings = posts.filter(
      (item) => postSection(item) === postSection(post),
    );
    const index = siblings.findIndex((item) => item.id === post.id);
    return {
      params: { slug: post.id },
      props: { post, earlier: siblings[index + 1], later: siblings[index - 1] },
    };
  });
}
const { post, earlier, later } = Astro.props;
const section = postSection(post);
const collection = writingSections[section];
const { Content } = await render(post);
// Math fonts/CSS are article-specific. No code/math font families on the index.
const mathCSS = post.data.hasMath
  ? (await import("katex/dist/katex.min.css?url")).default
  : null;
---

<SiteLayout
  title={post.data.title}
  description={post.data.description}
  graph={writingGraph([], post)}
  image={post.data.image}
  imageAlt={post.data.imageAlt}
  article
  section={section}
>
  {mathCSS && <link slot="head" rel="stylesheet" href={mathCSS} />}
  <article class="writing-article wrap">
    <header class="article-heading">
      <h1>{post.data.title}</h1>
      {section === "blog" && <p class="lede">{post.data.description}</p>}
    </header>
    <div class="article-margin">
      <ArticleDetails post={post} />
    </div>
    <div class="writing-prose">
      <Content components={{ a: PostLink }} />
    </div>
    <ArticleNavigation
      earlier={earlier}
      later={later}
      collection={collection}
    />
  </article>
</SiteLayout>
